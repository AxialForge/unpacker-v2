{
  "name": "unpacker-v2",
  "productName": "Unpacker V2",
  "version": "0.2.2",
  "description": "Drag-and-drop Windows archiver: create, extract, test and mass-convert ZIP/ZIP64, 7z, tar.* and more, with RAR extraction, built on the 7-Zip engine.",
  "main": "src/main/main.js",
  "author": "AxialForge",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/AxialForge/unpacker-v2",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxialForge/unpacker-v2.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/**/*.test.js\"",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  }
}
